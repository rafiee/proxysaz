# Copy these into Northflank as environment variables.
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Comma-separated Telegram numeric user IDs who get the admin panel.
ADMIN_CHAT_IDS=111111111,222222222
# Neon connection string (any of Neon's formats work; the bot normalizes it).
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
